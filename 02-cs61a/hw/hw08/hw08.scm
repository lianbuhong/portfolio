(define (ascending? s) 
    (cond ((null? s) #t)
        ((null? (cdr s)) #t)
        (else (if (> (car s) (car (cdr s)))
            #f
            (ascending? (cdr s))))
    )
)

(define (my-filter pred s) 
    (define (helper s result)
        (if (null? s)
            result
            (if (pred (car s))  
                (helper (cdr s) (append result (list (car s))))
                (helper (cdr s) result)
            )
        )
    )
    (helper s ())
)

(define (interleave lst1 lst2) 
    (define (helper lst1 lst2 result)
        (cond ((null? lst1)(append result lst2))
                ((null? lst2)(append result lst1))
                (else (helper (cdr lst1) (cdr lst2) (append result (list (car lst1)) (list (car lst2)))))
        )
    )
    (helper lst1 lst2 ())
)

(define (no-repeats s) 
    (if (null? s) s
    (cons(car s)
        (no-repeats (filter (lambda(x) (not (=(car s) x))) (cdr s)))
    )
    )
)
